# Copy to `.env` and fill in. NEVER commit `.env`.

# Supabase: Project Settings -> Database -> Connection string -> "URI".
# Prefer the "Session pooler" string for local dev. Change the prefix to
# `postgresql+psycopg2://` so SQLAlchemy uses the right driver.
DATABASE_URL=postgresql+psycopg2://postgres.abcdefgh:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Which frontend origins may call this API (comma-separated).
CORS_ORIGINS=http://localhost:5173
