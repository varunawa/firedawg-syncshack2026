# Copy to `.env` and fill in. NEVER commit `.env`.

# Supabase -> "Connect" button -> use the session-mode pooler string (port 5432).
# Change the prefix to `postgresql+psycopg2://` so SQLAlchemy uses psycopg2.
# URL-encode any special characters in the password (# -> %23, + -> %2B, ! -> %21, @ -> %40).
DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Which frontend origins may call this API (comma-separated).
CORS_ORIGINS=http://localhost:5173

# WaterNSW WaterInsights API
WATERNSW_API_KEY=YOUR_WATERNSW_API_KEY
WATERNSW_API_SECRET=YOUR_WATERNSW_API_SECRET
