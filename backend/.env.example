# Copy to `.env` and fill in. NEVER commit `.env`.

# Supabase -> "Connect" button -> use the session-mode pooler string (port 5432).
# Change the prefix to `postgresql+psycopg://` so SQLAlchemy uses psycopg v3.
# URL-encode any special characters in the password (# -> %23, + -> %2B, ! -> %21, @ -> %40).
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Which frontend origins may call this API (comma-separated).
CORS_ORIGINS=http://localhost:5173
